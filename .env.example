DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v5-text-small
JINA_RERANK_MODEL=jina-reranker-v3.5
RETRIEVE_TOP_K=10
RERANK_TOP_N=3

# --- API server ---
# Shared secret the AMWAL backend sends as X-API-Key (generate a long random value)
API_KEY=ganti-dengan-secret-acak

# --- Optional tuning (defaults shown) ---
HTTP_TIMEOUT=30
LLM_MAX_RETRIES=3
JINA_EMBED_BATCH_SIZE=32
JINA_MAX_RETRIES=3
# Seconds to wait on HTTP 429 when no Retry-After header is sent
JINA_RATE_LIMIT_BACKOFF=5,15,30
# Seconds to wait on HTTP 5xx / network errors
JINA_SERVER_BACKOFF=1,2,4
# Pace bulk embedding under the free-tier limit (100K TPM); 0 = off (paid tier)
JINA_TARGET_TPM=80000
# /chat path: retries and delay for Jina/DeepSeek (keep short; server cuts at 60s)
CHAT_MAX_RETRIES=1
CHAT_RETRY_DELAY=1.0
# API server limits: concurrent /chat, queue wait before 429, total budget before 504
MAX_CONCURRENT_REQUESTS=10
QUEUE_WAIT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=60
# Expose /docs and /openapi.json (local testing only)
ENABLE_DOCS=false
